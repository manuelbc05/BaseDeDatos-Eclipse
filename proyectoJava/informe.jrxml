<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ListadoReparacionesJoin"
    pageWidth="595" pageHeight="842"
    columnWidth="555"
    leftMargin="20" rightMargin="20"
    topMargin="30" bottomMargin="30">

    <!-- PARÁMETROS -->
    <parameter name="titulo" class="java.lang.String"/>
    <parameter name="autor" class="java.lang.String"/>
    <parameter name="fecha" class="java.lang.String"/>

    <!-- CONSULTA -->
    <queryString language="SQL"><![CDATA[
        SELECT
            r.id_reparacion,
            c.nombre_completo AS cliente,
            CONCAT(e.nombre, ' ', e.apellidos) AS empleado,
            t.nombre AS tienda,
            r.fecha_entrada,
            r.fecha_salida,
            r.estado
        FROM reparaciones r
        JOIN clientes c ON r.id_cliente = c.id_cliente
        JOIN empleados e ON r.id_empleado = e.id_empleado
        JOIN tiendas t ON r.id_tienda = t.id_tienda
        ORDER BY r.id_reparacion
    ]]></queryString>

    <!-- CAMPOS -->
    <field name="id_reparacion" class="java.lang.Integer"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="empleado" class="java.lang.String"/>
    <field name="tienda" class="java.lang.String"/>
    <field name="fecha_entrada" class="java.sql.Date"/>
    <field name="fecha_salida" class="java.sql.Date"/>
    <field name="estado" class="java.lang.String"/>

    <!-- TÍTULO -->
    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="555" height="35"/>
                <textElement textAlignment="Center">
                    <font size="24" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{titulo}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[
                    "Realizado por: " + $P{autor} + " - " + $P{fecha}
                ]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- CABECERA -->
    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25"/>
            </rectangle>

            <staticText><reportElement x="5" y="5" width="40" height="15"/><text>ID</text></staticText>
            <staticText><reportElement x="50" y="5" width="100" height="15"/><text>Cliente</text></staticText>
            <staticText><reportElement x="155" y="5" width="120" height="15"/><text>Empleado</text></staticText>
            <staticText><reportElement x="280" y="5" width="80" height="15"/><text>Tienda</text></staticText>
            <staticText><reportElement x="365" y="5" width="80" height="15"/><text>Entrada</text></staticText>
            <staticText><reportElement x="450" y="5" width="80" height="15"/><text>Salida</text></staticText>
        </band>
    </columnHeader>

    <!-- DETALLE -->
    <detail>
        <band height="20">
            <textField><reportElement x="5" y="2" width="40" height="15"/><textFieldExpression><![CDATA[$F{id_reparacion}]]></textFieldExpression></textField>
            <textField><reportElement x="50" y="2" width="100" height="15"/><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField><reportElement x="155" y="2" width="120" height="15"/><textFieldExpression><![CDATA[$F{empleado}]]></textFieldExpression></textField>
            <textField><reportElement x="280" y="2" width="80" height="15"/><textFieldExpression><![CDATA[$F{tienda}]]></textFieldExpression></textField>
            <textField><reportElement x="365" y="2" width="80" height="15"/><textFieldExpression><![CDATA[$F{fecha_entrada}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="2" width="80" height="15"/><textFieldExpression><![CDATA[$F{fecha_salida}]]></textFieldExpression></textField>
        </band>
    </detail>

    <!-- PIE -->
    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="0" width="555" height="1"/></line>
            <textField>
                <reportElement x="430" y="10" width="120" height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- RESUMEN -->
    <summary>
        <band height="30">
            <rectangle><reportElement x="0" y="0" width="555" height="25"/></rectangle>
            <textField>
                <reportElement x="10" y="5" width="300" height="15"/>
                <textFieldExpression><![CDATA[
                    "Total Reparaciones: " + $V{REPORT_COUNT}
                ]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
